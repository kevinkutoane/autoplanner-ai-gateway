# AutoPlanner AI Gateway Configuration Template
# Copy this file to .env for local development

ENVIRONMENT=development
PORT=8080
GATEWAY_VERSION=1.0.0

# Authentication
# In production, AUTH_REQUIRED must be true.
# In development, set DEV_BEARER_TOKEN to test authenticated requests.
AUTH_REQUIRED=true
DEV_BEARER_TOKEN=dev-secret-token-change-me

# Google Gemini API Configuration
# In Cloud Run, inject this securely from Secret Manager:
# gcloud run services update autoplanner-ai-gateway --set-secrets=GEMINI_API_KEY=projects/PROJECT_ID/secrets/GEMINI_API_KEY:latest
GEMINI_API_KEY=your-gemini-api-key-here

# Model Selection
FAST_MODEL=gemini-2.5-flash
PRO_MODEL=gemini-2.5-pro

# Request Limits & Safeguards
MAX_REQUEST_BYTES=262144
MAX_INPUT_TEXT_CHARS=50000
MAX_CONTEXT_SERIALIZED_BYTES=131072
REQUEST_TIMEOUT_SECONDS=30.0
UPSTREAM_TIMEOUT_SECONDS=25.0
RATE_LIMIT_RPM=60
